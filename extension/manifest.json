{
  "manifest_version": 3,
  "name": "Compass Economic Calendar",
  "version": "1.1.0",
  "description": "Market-moving events, counted down: FOMC, CPI, jobs, Fed Chair remarks and Treasury auctions, with alerts in your time zone.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://compasseconomiccalendar.github.io/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Compass Economic Calendar"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      }
    }
  }
}
